/* =========================================================
   Base Node
   ========================================================= */

.node {
    background-color: rgb(42, 45, 54);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.node #title-label {
    color: #FFFFFF;
    -unity-font-style: bold;
    width: 100%;
}

/* 확장 영역(EnumField, TextField) 내부 스타일 조정 */
.node .unity-base-field {
    margin: 2px 4px;
    padding: 2px;
}

.node .unity-label {
    min-width: 80px;
    color: #E0E0E0;
}

/* 타이틀 내부의 TextField 스타일 */
#title > .unity-text-field {
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

/* TextField 내부의 실제 입력창(TextInput) 스타일 */
#title > .unity-text-field > .unity-text-field__input {
    background-color: transparent; /* 배경을 투명하게 해서 타이틀 배경색 유지 */
    border-width: 0;
    padding: 2px 4px;
    margin: 0;

    /* 텍스트 정렬 및 스타일 */
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    font-size: 14px;
    color: white; /* 글자색은 배경에 맞춰 조정 */
}


/* =========================================================
   Title 색상 변경
   ========================================================= */
.root-node #title {
    background-color: rgb(83, 83, 83);
    border-bottom-width: 1px;
    border-bottom-color: rgb(83, 83, 83);
}

.composite-node #title {
    background-color: rgb(71, 242, 151);
    border-bottom-width: 1px;
    border-bottom-color: rgb(71, 242, 151);
}

.composite-node #title > .unity-text-field > .unity-text-field__input {
    color: rgb(80, 80, 80) !important;
}

.condition-node #title {
    background-color: rgb(255, 156, 49);
    border-bottom-width: 1px;
    border-bottom-color: rgb(255, 156, 49);
}

.action-node #title {
    background-color: rgb(71, 140, 242);
    border-bottom-width: 1px;
    border-bottom-color: rgb(71, 140, 242);
}

/* =========================================================
   Enum Fields 색상 및 스타일 변경 ( selector )
   ========================================================= */
.bt-node__field {
    margin-top: 6px;
    margin-bottom: 6px;
    margin-left: 8px;
    margin-right: 8px;
    min-height: 25px;
}

.bt-node__field-label {
    min-width: 80px;
    color: rgb(220, 226, 242);
    -unity-font-style: bold;
}

.bt-node__input {
    background-color: rgb(55, 60, 72);
    color: rgb(242, 245, 250);

    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;

    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;

    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    border-top-color: rgba(255, 255, 255, 0.05);
    border-bottom-color: rgba(255, 255, 255, 0.05);

    padding-left: 6px;
    padding-right: 6px;
    min-height: 24px;
}

.bt-node__input:focus {
    border-left-color: rgb(120, 170, 255);
    border-right-color: rgb(120, 170, 255);
    border-top-color: rgb(120, 170, 255);
    border-bottom-color: rgb(120, 170, 255);
}

.unity-text-field__input.bt-node__input,
.unity-base-text-field__input.bt-node__input,
.unity-enum-field__input.bt-node__input,
.unity-popup-field__input.bt-node__input,
.unity-base-popup-field__input.bt-node__input {
    color: rgb(242, 245, 250);
    background-color: rgb(55, 60, 72);
}

