  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_01
    Kor: "\uC900\uBE44\uB294 \uC774\uC81C \uAC70\uC758 \uB05D\uB0AC\uC5B4. \uB9C8\uC9C0\uB9C9\uC73C\uB85C
      \uD655\uC778\uD560 \uAC8C \uD558\uB098 \uB0A8\uC558\uC5B4."
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 0
    Speaker: NPC
  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_02
    Kor: "\uB9C8\uC9C0\uB9C9 \uD655\uC778? \uBB50\uAC00 \uADF8\uB807\uAC8C \uC911\uC694\uD55C\uB370?"
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 1
    Speaker: Player
  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_03
    Kor: "\uB124\uAC00 \uC9C4\uC9DC \uC774 \uAE38\uC744 \uC120\uD0DD\uD560 \uB9C8\uC74C\uC758
      \uC900\uBE44\uAC00 \uB410\uB294\uC9C0 \uADF8\uAC70\uC57C."
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 2
    Speaker: NPC
  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_04
    Kor: "\uAC11\uC790\uAE30 \uC65C \uADF8\uB807\uAC8C \uC9C4\uC9C0\uD574\uC838\u2026
      \uADF8\uB798\uB3C4 \uB3C4\uB9DD\uCE60 \uC0DD\uAC01\uC740 \uC5C6\uC5B4."
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 3
    Speaker: Player
  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_05
    Kor: "\uC88B\uC544. \uADF8 \uB9D0 \uB098\uC911\uC5D0 \uD6C4\uD68C\uD558\uC9C0
      \uB9C8. \uC704\uD5D8\uD574\uB3C4 \uB09C \uB124 \uD3B8\uC774\uB2C8\uAE4C."
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 4
    Speaker: NPC
  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_06
    Kor: "\uADF8\uB798\uC11C \uB354 \uC548\uC2EC\uC774 \uB418\uB294\uB370? \uD63C\uC790\uC600\uB2E4\uBA74
      \uBC8C\uC368 \uB3C4\uB9DD\uAC14\uC744\uC9C0\uB3C4 \uBAB0\uB77C."
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 5
    Speaker: Player
  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_07
    Kor: "\uADF8\uB7FC \uCD9C\uBC1C \uC804\uC5D0 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBB3B\uACA0\uC5B4.
      \uC815\uB9D0\u2026 \uC900\uBE44\uB41C \uAC70\uC9C0?"
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 6
    Speaker: NPC
  - Category: "\uC2A4\uD1A0\uB9AC"
    Id: 1
    Key: shin_s4_08
    Kor: "\uC751. \uC774\uC81C\uBD80\uD130\uAC00 \uC9C4\uC9DC \uC2DC\uC791\uC774\uC796\uC544.
      \uAC19\uC774 \uAC00\uC790 \uC2E0 !"
    NPC: Shin
    IsStory: 1
    WorldStageMin: 3
    WorldStageMax: 3
    NpcStoryStage: 3
    Order: 7
    Speaker: Player
